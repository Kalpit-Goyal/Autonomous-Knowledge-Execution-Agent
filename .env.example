# ---------------------------------------------------------------------------
# Copy to `.env` and fill in. `.env` is gitignored - never commit real keys.
#   cp .env.example .env
# ---------------------------------------------------------------------------

# Groq. Create a key at https://console.groq.com/keys
GROQ_API_KEY=

# Model id. Any model your key can reach works.
#   openai/gpt-oss-20b   - open weights, good default; separate daily budget
#   openai/gpt-oss-120b  - larger/slower gpt-oss variant, stronger reasoning
#   llama-3.3-70b-versatile - fast general model, solid tool use
#   llama-4-scout-17b-16e-instruct - multimodal, very fast
#
# Groq enforces its daily token limit PER MODEL, not per account, so a model
# that has hit its cap is unblocked simply by switching to another one.
GROQ_MODEL=openai/gpt-oss-20b

# groq = talk to the real model (needs GROQ_API_KEY)
# fake = refuse every model call with a clear error, for wiring checks and
#        demos where you want the API up without spending tokens
AGENT_LLM_MODE=groq

# Sampling. NOTE: the gpt-oss models only accept 1.0 on Groq and reject any
# other value with a 400, so leave this alone unless you switch to a llama model.
GROQ_TEMPERATURE=1.0

# Only needed if you point at a proxy; the Groq public API is the default.
# GROQ_BASE_URL=https://api.groq.com

# ---------------------------------------------------------------------------
# Embeddings backend: auto | onnx | hashing
#   auto   - try Chroma's bundled ONNX MiniLM (free, local after 1st run),
#            fall back to the bundled hashing embedder if unavailable/offline
#   onnx   - require ONNX MiniLM, fail loudly otherwise
#   hashing- deterministic dependency-free fallback, no model download
# ---------------------------------------------------------------------------
EMBEDDING_BACKEND=auto

# ---------------------------------------------------------------------------
# Retrieval
# ---------------------------------------------------------------------------
RETRIEVAL_TOP_K=5
CHUNK_SIZE=900
CHUNK_OVERLAP=150

# ---------------------------------------------------------------------------
# Agent loop
# ---------------------------------------------------------------------------
MAX_ITERATIONS=4
MAX_PLAN_STEPS=6
MAX_PARALLEL_ACTIONS=5

# ---------------------------------------------------------------------------
# Services
# ---------------------------------------------------------------------------
API_HOST=127.0.0.1
API_PORT=8000
# Base URL the Streamlit UI uses to reach the FastAPI service
UI_API_BASE=http://127.0.0.1:8000

# Set to 1 to allow the agent to execute irreversible actions automatically.
# Leave at 0 so a human must approve them (recommended).
AUTO_APPROVE_IRREVERSIBLE=0
